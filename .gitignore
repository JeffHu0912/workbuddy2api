# Auth & secrets
auths/
auths-qq/
auths-reserve/
data/
data-qq/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin
/login.exe
/credit.exe
/wb2api.exe
/signin_bin.exe

# Config with secrets (use config.example.json)
config.json
config-qq.json
config.json.bak*

# Build artifacts
*.tmp
__pycache__/

# 运行时产物（API Key / 进程号 / 日志 / 工具草稿目录）
# 为什么显式列 .apikey：它不是 config.json 的别名，而是 login.sh 等工具单独落盘的密钥文件，
# 不写进这里会被 git add -A 直接提交（含明文 api_key）。
.apikey
.server.pid
wb2api.pid
*.log
draft_*_folder/

# Backups (contains auth tokens)
backups/
auths-backup-*/
auths-graveyard/
auths-quarantine/

# 第二实例（含独立 config.json + auths/，全部敏感）
instance-global/

# 本地合并 compose 草稿（含 api_key 占位，不入库）
docker-compose-merged.yml

# 本地编译工具产物（activity/credit 调试二进制，根目录锚定避免误伤 cmd/）
/activity_bin
/credit_bin

# 批量跑批日志（每号运行日志 + summary，含 uid 前 8 位，不入库）
logs/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 必须进版本库）
*.md
!README.md

# 本地 compose 备份（迁移/回滚用，不入库）
docker-compose.yml.bak*
